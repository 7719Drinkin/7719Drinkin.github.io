const textKeyByValue = new Map();
Object.entries(MUSIC_COPY).forEach(([, copy]) => {
  Object.entries(copy).forEach(([key, value]) => {
    if (typeof value === 'string' && !value.includes('{title}')) textKeyByValue.set(value.trim(), key);
  });
});

const hasCjk = (value = '') => /[\u3400-\u9fff\uf900-\ufaff]/u.test(String(value));
const languageTag = (value) => value === 'zh' ? 'zh-CN' : 'en';
const otherLanguage = (value) => value === 'zh' ? 'en' : 'zh';

function detectMusicLanguage() {
  try {
    const stored = localStorage.getItem(MUSIC_LANGUAGE_KEY);
    if (stored === 'zh' || stored === 'en') return stored;
  } catch {}

  const preferred = navigator.languages?.[0] || navigator.language || 'zh-CN';
  return String(preferred).toLowerCase().startsWith('zh') ? 'zh' : 'en';
}

let musicLanguage = detectMusicLanguage();

function interpolate(value, variables = {}) {
  return String(value).replace(/\{(\w+)\}/g, (_, key) => variables[key] ?? '');
}

function musicTranslate(key, variables = {}, language = musicLanguage) {
  const value = MUSIC_COPY[language]?.[key] ?? MUSIC_COPY.en?.[key] ?? key;
  return interpolate(value, variables);
}

function localized(value, language = musicLanguage) {
  if (value == null) return '';
  if (typeof value === 'string') {
    const key = textKeyByValue.get(value.trim());
    return key ? musicTranslate(key, {}, language) : value;
  }
  if (typeof value === 'object') {
    return value[language] ?? value.zh ?? value.en ?? '';
  }
  return String(value);
}

function readMusicPageData() {
  const node = document.querySelector('#music-i18n-page-data[type="application/json"]');
  if (!node) return null;
  try { return JSON.parse(node.textContent || '{}'); } catch { return null; }
}

const musicPageData = readMusicPageData();

function setElementLanguage(element, language) {
  if (!element) return;
  element.lang = languageTag(language);
  element.dataset.musicScript = language;
}

function bindBilingualElement(element, values, role) {
  if (!element || !values) return;
  const zh = localized(values, 'zh');
  const en = localized(values, 'en');
  if (!zh && !en) return;
  element.dataset.musicBilingualRole = role;
  element.dataset.musicZh = zh || en;
  element.dataset.musicEn = en || zh;
}

function applyBilingualElement(element) {
  const role = element.dataset.musicBilingualRole;
  if (!role) return;
  const language = role === 'secondary' ? otherLanguage(musicLanguage) : musicLanguage;
  const value = language === 'zh' ? element.dataset.musicZh : element.dataset.musicEn;
  if (value != null) element.textContent = value;
  setElementLanguage(element, language);
}

function bindPair(primary, secondary, values) {
  bindBilingualElement(primary, values, 'primary');
  bindBilingualElement(secondary, values, 'secondary');
}

function inferBilingualValues(first, second) {
  const a = String(first || '').trim();
  const b = String(second || '').trim();
  if (!a && !b) return null;
  if (hasCjk(a) && !hasCjk(b)) return { zh: a, en: b };
  if (hasCjk(b) && !hasCjk(a)) return { zh: b, en: a };
  return { zh: a || b, en: b || a };
}

function bindStaticCopy(element, key, mode = 'text') {
  if (!element || !key) return;
  element.dataset.musicI18n = key;
  element.dataset.musicI18nMode = mode;
}

function applyStaticCopy(element) {
  const key = element.dataset.musicI18n;
  if (!key) return;
  const value = musicTranslate(key);
  const mode = element.dataset.musicI18nMode || 'text';

  if (mode === 'leading') {
    let textNode = [...element.childNodes].find((node) => node.nodeType === Node.TEXT_NODE);
    if (!textNode) {
      textNode = document.createTextNode('');
      element.prepend(textNode);
    }
